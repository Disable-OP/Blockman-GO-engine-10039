{
  "name": "Blockman Engine Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "runArgs": [
    "--privileged",
    "--device", "/dev/kvm"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh; bash .devcontainer/auto_build.sh",
  "forwardPorts": [5554, 5555, 19130],
  "remoteEnv": {
    "ANDROID_HOME": "/home/vscode/android-sdk",
    "ANDROID_SDK_ROOT": "/home/vscode/android-sdk",
    "ANDROID_NDK_HOME": "/home/vscode/android-ndk-r17c",
    "ANDROID_NDK_ROOT": "/home/vscode/android-ndk-r17c",
    "NDK_ROOT": "/home/vscode/android-ndk-r17c",
    "JAVA_HOME": "/usr/lib/jvm/java-8-openjdk-amd64",
    "GRADLE_OPTS": "-Dhttps.protocols=TLSv1.2",
    "DISPLAY": ":0"
  }
}
